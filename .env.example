# Скопируй этот файл в .env и впиши свои значения.
# .env в git НЕ коммитится (он в .gitignore).

# Entra -> Регистрация приложений -> xorazmiy-admin-scripts -> Обзор
TENANT_ID=идентификатор-каталога-клиента
CLIENT_ID=идентификатор-приложения-клиента

# Сертификаты и секреты -> колонка "Значение" (не "Идентификатор секрета")
CLIENT_SECRET=значение-секрета
